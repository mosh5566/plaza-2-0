# העתק לקובץ .env והגדר ערכים אמיתיים בפרודקשן
PORT=3000
JWT_SECRET=שנה-אותי-מיד-בפרודקשן-מחרוזת-ארוכה-וייחודית

# ─── התחברות חברתית (אופציונלי — הדף עובד בלעדיהם עם אימייל/סיסמה) ───
# Google: צור OAuth Client ב-https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Telegram: צור בוט עם @BotFather, קח את הטוקן ואת מזהה הבוט (המספר לפני ה-:)
# TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx
# TELEGRAM_BOT_ID=123456

# ─── שליחת מייל (לאיפוס סיסמה) — בלי זה הקוד מוחזר למסך לבדיקה ───
# Resend: https://resend.com  (חינם עד 100 מיילים/יום)
# RESEND_API_KEY=re_xxxxx
# MAIL_FROM=PLAZA <noreply@yourdomain.com>

# (אופציונלי) שירותים חיצוניים נוספים
# DEEPL_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_MAPS_API_KEY=
# TWILIO_SID=
# TWILIO_TOKEN=
# S3_BUCKET=
# S3_REGION=
# REDIS_URL=
